{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", ".storybook/**/*"]
}
